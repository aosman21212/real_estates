<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Maintenance List View -->
    <record id="view_real_estate_maintenance_list" model="ir.ui.view">
        <field name="name">real.estate.maintenance.list</field>
        <field name="model">real.estate.maintenance</field>
        <field name="arch" type="xml">
            <list string="Maintenance Requests">
                <field name="sequence"/>
                <field name="name"/>
                <field name="building_id"/>
                <field name="unit_id"/>
                <field name="tenant_id"/>
                <field name="date_reported"/>
                <field name="priority" widget="priority"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'new'"
                    decoration-warning="state == 'in_progress'"
                    decoration-success="state == 'done'"
                    decoration-danger="state == 'cancelled'"/>
                <field name="cost"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Maintenance Form View -->
    <record id="view_real_estate_maintenance_form" model="ir.ui.view">
        <field name="name">real.estate.maintenance.form</field>
        <field name="model">real.estate.maintenance</field>
        <field name="arch" type="xml">
            <form string="Maintenance Request">
                <header>
                    <button name="action_start" string="Start" type="object"
                        invisible="state != 'new'"
                        class="btn-primary"/>
                    <button name="action_done" string="Mark Done" type="object"
                        invisible="state != 'in_progress'"
                        class="btn-primary"/>
                    <button name="action_cancel" string="Cancel" type="object"
                        invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="new,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_bill" type="object"
                            class="oe_stat_button" icon="fa-money"
                            invisible="bill_count == 0">
                            <field name="bill_count" widget="statinfo" string="Bill"/>
                        </button>
                        <button name="action_create_bill" type="object"
                            class="oe_stat_button" icon="fa-money"
                            invisible="bill_count != 0">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Create Bill</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="sequence" string="Reference"/>
                        <h2><field name="sequence" readonly="1"/></h2>
                        <h1>
                            <field name="name" placeholder="Maintenance Subject"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Location">
                            <field name="building_id"/>
                            <field name="unit_id"
                                domain="[('building_id', '=', building_id)]"
                                context="{'default_building_id': building_id}"/>
                            <field name="lease_id"
                                domain="[('unit_id', '=', unit_id)]"
                                context="{'default_unit_id': unit_id}"/>
                            <field name="tenant_id"/>
                        </group>
                        <group string="Details">
                            <field name="priority" widget="priority"/>
                            <field name="date_reported"/>
                            <field name="date_resolved"/>
                            <field name="vendor_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="cost"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Maintenance Kanban View -->
    <record id="view_real_estate_maintenance_kanban" model="ir.ui.view">
        <field name="name">real.estate.maintenance.kanban</field>
        <field name="model">real.estate.maintenance</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="building_id"/>
                <field name="unit_id"/>
                <field name="tenant_id"/>
                <field name="priority"/>
                <field name="date_reported"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="fw-bold"><field name="name"/></div>
                            <div class="text-muted">
                                <field name="building_id"/> – <field name="unit_id"/>
                            </div>
                            <div><field name="priority" widget="priority"/> <field name="date_reported"/></div>
                            <div t-if="record.tenant_id.raw_value">
                                Tenant: <field name="tenant_id"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Maintenance Search View -->
    <record id="view_real_estate_maintenance_search" model="ir.ui.view">
        <field name="name">real.estate.maintenance.search</field>
        <field name="model">real.estate.maintenance</field>
        <field name="arch" type="xml">
            <search string="Search Maintenance">
                <field name="name"/>
                <field name="building_id"/>
                <field name="unit_id"/>
                <field name="tenant_id"/>
                <filter string="New" name="new" domain="[('state', '=', 'new')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="Urgent" name="urgent" domain="[('priority', 'in', ['urgent', 'very_urgent'])]"/>
                <group>
                    <filter string="Building" name="group_building" context="{'group_by': 'building_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                    <filter string="Unit" name="group_unit" context="{'group_by': 'unit_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Maintenance Action -->
    <record id="action_real_estate_maintenance" model="ir.actions.act_window">
        <field name="name">Maintenance Requests</field>
        <field name="res_model">real.estate.maintenance</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_real_estate_maintenance_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No maintenance requests yet!
            </p>
        </field>
    </record>

</odoo>

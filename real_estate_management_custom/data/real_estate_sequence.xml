<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="seq_real_estate_lease" model="ir.sequence">
        <field name="name">Real Estate Lease</field>
        <field name="code">real.estate.lease</field>
        <field name="prefix">LEASE/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_real_estate_maintenance" model="ir.sequence">
        <field name="name">Real Estate Maintenance</field>
        <field name="code">real.estate.maintenance</field>
        <field name="prefix">MNT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
